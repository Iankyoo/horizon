# Copie para .env (git-ignorado) e ajuste os valores antes de rodar `docker compose up`.

DB_NAME=horizon_db
DB_USER=horizon_user
DB_PASSWORD=change-me

# Gere com: openssl rand -base64 32
JWT_SECRET=change-me-generate-a-random-base64-secret-at-least-32-bytes
JWT_EXPIRATION=86400000

# Porta do host mapeada para a API no docker-compose (container sempre expõe 8080)
APP_PORT=8081

# Porta do host mapeada para o Postgres no docker-compose (container sempre expõe 5432)
DB_PORT=5544

# Login único da API (Spring Security + JWT). Nunca a senha em texto puro —
# ADMIN_PASSWORD_HASH é um hash BCrypt. Veja README para como gerar.
# IMPORTANTE: escape todo "$" do hash como "$$" aqui (docker-compose interpola
# "$" no .env como variável — sem isso o hash chega corrompido no container).
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=change-me-bcrypt-hash-com-cifrao-escapado-como-cifrao-cifrao
